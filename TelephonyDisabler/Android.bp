android_app {
    name: "TelephonyDisabler",

    srcs: ["src/**/*.kt"],

    sdk_version: "current",
    product_specific: true,
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "org.lineageos.telephonydisabler.xml",

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
    required: [
        "hidden-api-whitelist-org.lineageos.telephonydisabler.xml",
    ],
    overrides: [
        "Dialer",
        "GoogleDialer",
    ],
}

prebuilt_etc {
    name: "hidden-api-whitelist-org.lineageos.telephonydisabler.xml",
    relative_install_path: "sysconfig",
    filename: "hidden-api-whitelist-org.lineageos.telephonydisabler.xml",
    src: "hidden-api-whitelist-org.lineageos.telephonydisabler.xml",
    product_specific: true,
}
